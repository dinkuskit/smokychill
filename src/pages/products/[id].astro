---
import { getEmDashCollection } from "emdash";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { STORE_TITLE, collectionPath, loadStorefrontRouteContext, productPath } from "../../features/store-shell/index.js";
import { readPublicVariantProduct } from "../../features/commerce-catalog/variant-public.js";
import { formatUsdMinor } from "../../features/store-shell/price.js";
import "../../features/store-shell/global.css";
import seed from "../../../seed/seed.json";

const merchandise = await getEmDashCollection<"merchandise", Record<string, unknown>>("merchandise", { status: "published" });
const { profile, demonstrations, collections } = await loadStorefrontRouteContext(merchandise.entries);
const herbalIceFallback = {
  id: "herbal-ice",
  title: "Herbal Ice Cooling Balm",
  description: "A cooling topical balm with menthol and camphor, made with CBD isolate in three strengths. Fans nicknamed it “the ice balm.”",
  illustration: "balm",
  availabilitySource: "preview",
};
const cmsCollection = collections.find((group) => group.items.some((candidate) => productPath(candidate.id) === Astro.url.pathname));
const cmsItem = cmsCollection?.items.find((candidate) => productPath(candidate.id) === Astro.url.pathname);
const item = cmsItem ?? (Astro.url.pathname === "/products/herbal-ice" ? herbalIceFallback : undefined);
const collection = cmsCollection ?? (item ? { name: "Herbal Ice", items: [item] } : undefined);
const collectionHref = cmsCollection ? collectionPath(cmsCollection.name) : "/";
const products = await getEmDashCollection<"products", Record<string, unknown>>("products", { status: "published" });
const cmsProduct = products.entries.find((entry) => entry.id === "herbal-ice" || entry.id === "herbal-ice-draft");
const bootstrapProduct = (seed.content.products as { slug: string; data: Record<string, unknown> }[]).find((product) => product.slug === "herbal-ice");
const productData = (cmsProduct?.data ?? bootstrapProduct?.data ?? {}) as Record<string, unknown>;
const cmsStrengths = Array.isArray(productData.strengths) ? productData.strengths.filter((value): value is Record<string, unknown> =>
  value !== null && typeof value === "object" && !Array.isArray(value) && typeof value.mg === "number" && typeof value.sku === "string",
) : [];
const commerceVariants = await readPublicVariantProduct(
  { runtime: Astro.locals.emdash, request: Astro.request },
  "Herbal Ice Cooling Balm",
).catch(() => null);
const strengths = commerceVariants?.members.length
  ? commerceVariants.members.map((member) => ({
      mg: member.selections.find((selection) => selection.optionLabel === "Strength")?.valueLabel ?? "Strength",
      sku: cmsStrengths.find((strength) => `${strength.mg} mg` === member.selections.find((selection) => selection.optionLabel === "Strength")?.valueLabel)?.sku ?? "Pending",
      itemId: member.catalogItemId,
      priceMinor: member.price.minor,
      priceText: formatUsdMinor(member.price.minor),
      formulaStatus: cmsStrengths.find((strength) => `${strength.mg} mg` === member.selections.find((selection) => selection.optionLabel === "Strength")?.valueLabel)?.formula_status ?? "Formula details pending.",
      coaStatus: "COA coming soon",
    }))
  : cmsStrengths.map((strength) => ({
      mg: `${strength.mg} mg`,
      sku: strength.sku as string,
      itemId: strength.sku as string,
      priceMinor: null,
      priceText: null,
      formulaStatus: typeof strength.formula_status === "string" ? strength.formula_status : "Formula details pending.",
      coaStatus: "COA coming soon",
    }));
const defaultStrength = strengths[0];
if (!item) Astro.response.status = 404;
const managed = item?.availabilitySource === "managed" ? demonstrations?.managed ?? null : null;
const unmanaged = item?.availabilitySource === "unmanaged" ? demonstrations?.unmanaged ?? null : null;
const status = managed ? `${managed.inventory.available} available` : unmanaged ? ({
  "in-stock": "In stock", "out-of-stock": "Out of stock", "available-on-backorder": "Available on backorder",
  "availability-unavailable": "Availability unavailable", "low-stock": "Low stock",
} as Record<string, string>)[unmanaged.storefront.status] ?? "Availability unavailable" : "Preview only · not purchasable";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={item?.description ?? "Product not found."} />
    {item && <link rel="canonical" href={`${Astro.site ?? Astro.url.origin}/products/herbal-ice`} />}
    <title>{item ? `${item.title} | ${STORE_TITLE}` : `Product not found | ${STORE_TITLE}`}</title>
    {item && commerceVariants && <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      name: "Herbal Ice Cooling Balm",
      productID: "herbal-ice-4oz",
      description: item.description,
      image: [`${Astro.url.origin}/images/herbal-ice-hero.webp`],
      brand: { "@type": "Brand", name: "Smoky Co" },
      manufacturer: {
        "@type": "Organization",
        name: "Smoky Product Company",
        address: { "@type": "PostalAddress", streetAddress: "55 Eagles Nest Trail", addressLocality: "Murphy", addressRegion: "NC", postalCode: "28906", addressCountry: "US" },
      },
      hasVariant: strengths.map((strength) => ({
        "@type": "Product",
        name: `Herbal Ice Cooling Balm — ${strength.mg}`,
        sku: strength.sku,
        brand: { "@type": "Brand", name: "Smoky Co" },
        manufacturer: { "@type": "Organization", name: "Smoky Product Company" },
        offers: {
          "@type": "Offer",
          price: Number(strength.priceMinor) / 100,
          priceCurrency: "USD",
          sku: strength.sku,
          url: `${Astro.url.origin}/products/herbal-ice`,
        },
      })),
    })} />}
  </head>
  <body data-storefront-profile={profile}>
    <SiteHeader />
    <main class="product-page">
      <nav class="browse-breadcrumb" aria-label="Breadcrumb"><a href="/">Catalog</a><span aria-hidden="true">/</span>{collection && <><a href={collectionHref}>{collection.name}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{item?.title ?? "Not found"}</span></nav>
      {item && collection ? (
        <article class="product-detail" data-product-page={item.id} data-product-source={item.availabilitySource}>
          <div class="product-detail__visual"><img src="/images/herbal-ice-hero.webp" alt="Herbal Ice 4 oz cooling balm jar" width="800" height="800" /></div>
          <div class="product-detail__body">
            <p class="product-detail__eyebrow">{collection.name}</p>
            <h1>{item.title}</h1>
            <p class="product-detail__description">{item.description}</p>
            <label class="strength-picker" for="strength">CBD strength</label>
            <select id="strength" data-strength-selector>
              {strengths.map((strength, index) => <option value={strength.itemId} selected={index === 0}>{strength.mg}</option>)}
            </select>
            <p class="strength-meta" data-strength-mg>Selected strength: {defaultStrength?.mg ?? "Pending"}</p>
            <p class="strength-meta" data-strength-sku>SKU: {defaultStrength?.sku ?? "Pending"}</p>
            <p class="product-detail__price" data-strength-price>{defaultStrength?.priceText ?? "Commerce price unavailable"}</p>
            <p class="strength-meta" data-strength-status>{defaultStrength?.formulaStatus ?? "Formula details pending."} {defaultStrength?.coaStatus ?? "COA coming soon"}</p>
            {managed && <p class="product-detail__price" data-product-price><strong data-regular-price>{managed.price.regularText}</strong></p>}
            {unmanaged && <p class="product-detail__price" data-product-price>{unmanaged.price.saleText ? <><s data-regular-price>{unmanaged.price.regularText}</s> <strong data-sale-price>{unmanaged.price.saleText}</strong></> : <strong data-regular-price>{unmanaged.price.regularText}</strong>}</p>}
            <p class="product-detail__status" data-product-status data-availability-status={unmanaged?.storefront.status}>{status}</p>
            <p class="product-detail__notice">Checkout unavailable until a server-owned Payments binding exists. Product copy remains a CMS draft.</p>
            <div class="product-detail__facts"><h2>Details</h2><ul><li>Menthol and camphor cooling balm</li><li>4 oz jar · select a CBD strength above</li><li>Topical use only; not for ingestion</li><li>Batch COA: <strong>coming soon</strong></li><li>Manufactured by Smoky Product Company, 55 Eagles Nest Trail, Murphy, NC 28906</li></ul></div>
            <div class="product-detail__facts"><h2>Ingredients</h2><p>Coco-Caprylate/Caprate, Babassu Oil, White Beeswax, Cetyl Alcohol, Menthol Crystals, Cera Bellina (Polyglyceryl-3 Beeswax), Camphor Crystals, Japanese Peppermint Essential Oil, Eucalyptus Globulus Essential Oil, CBD Isolate, Vitamin E (T95 / Tocopherol), Alpha Bisabolol.</p></div>
            <div class="product-detail__facts"><h2>How to use</h2><p>Apply to skin as desired. Wash hands after application. Avoid eyes and mucous membranes. For external use only. Keep out of reach of children.</p></div>
            <a class="product-detail__back" href={collectionHref}>← Back home</a>
          </div>
        </article>
      ) : <><h1>Product not found</h1><p>This product is not published or does not exist.</p><a href="/">Return to catalog</a></>}
    </main>
    <SiteFooter />
  </body>
</html>
<script define:vars={{ strengths }}>
  const selector = document.querySelector("[data-strength-selector]");
  const sku = document.querySelector("[data-strength-sku]");
  const mg = document.querySelector("[data-strength-mg]");
  const status = document.querySelector("[data-strength-status]");
  const price = document.querySelector("[data-strength-price]");
  selector?.addEventListener("change", () => {
    const selected = strengths.find((strength) => strength.itemId === selector.value);
    if (selected && sku && mg && status && price) {
      mg.textContent = `Selected strength: ${selected.mg}`;
      sku.textContent = `SKU: ${selected.sku}`;
      price.textContent = selected.priceText ?? "Commerce price unavailable";
      status.textContent = `${selected.formulaStatus} ${selected.coaStatus}`;
    }
  });
</script>
<style>
  .product-page{width:min(70rem,calc(100% - 2rem));margin:0 auto;min-height:65vh}
  .browse-breadcrumb{display:flex;flex-wrap:wrap;gap:.7rem;padding:2rem 0;color:var(--store-muted)}
  .browse-breadcrumb a{color:inherit;text-underline-offset:.2em}
  .product-detail{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:clamp(1.5rem,5vw,5rem);align-items:center;margin:1rem 0 5rem}
  .product-detail__visual{min-width:0;aspect-ratio:4/3;overflow:hidden;border-radius:1rem;background:#e9e8df}
  .product-detail__visual--hoodie{background:#dce2df}.product-detail__visual--cap{background:#e6ddd1}.product-detail__visual--beanie{background:#e2e1d6}
  .product-detail__visual img{display:block;width:100%;height:100%;object-fit:cover}
  .product-detail__body{min-width:0;overflow-wrap:anywhere}
  .product-detail__eyebrow{color:var(--store-muted);font-size:.75rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  h1{font-size:clamp(2.5rem,6vw,5.5rem);line-height:1;letter-spacing:-.05em;margin:.4rem 0 1.5rem}
  .product-detail__description{font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.6}
  .product-detail__price{display:flex;gap:.7rem;align-items:baseline;font-size:1.5rem}.product-detail__price s{color:var(--store-muted)}
  .product-detail__status{font-size:1.25rem;font-weight:800;margin:2rem 0 .5rem}
  .product-detail__notice{line-height:1.5;color:var(--store-muted)}
  .strength-picker{display:block;font-weight:800;margin-top:1.5rem}.strength-picker+select{width:100%;max-width:20rem;padding:.8rem;border:2px solid var(--ice-line);border-radius:.5rem;background:#fff;color:var(--ice-ink);font:inherit}.strength-meta{color:var(--ice-muted);font-size:.85rem}
  .product-detail__back{display:inline-block;margin-top:2rem;color:inherit;font-weight:800;text-underline-offset:.25em}
  @media(max-width:40rem){.product-detail{grid-template-columns:1fr;gap:1.5rem}}
</style>
