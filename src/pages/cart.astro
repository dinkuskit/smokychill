---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LaunchRobotsMeta from "../components/LaunchRobotsMeta.astro";
import { GuestCart } from "../features/guest-cart/ui.ts";
import { STORE_TITLE, readStorefrontProfile } from "../features/store-shell/index.js";
import "../features/store-shell/global.css";

const profile = readStorefrontProfile();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <LaunchRobotsMeta />
    <title>Cart | {STORE_TITLE}</title>
  </head>
  <body data-storefront-profile={profile}>
    <SiteHeader />
    <main>
      <GuestCart />
    </main>
    <SiteFooter />
  </body>
</html>
