---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../features/store-shell/global.css";
const title = "Herbal Ice Cooling Balm | Smoky Chill";
const description = "A cooling topical balm with menthol, camphor, and CBD isolate in a 4 oz jar.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={`${Astro.site ?? Astro.url.origin}/`} />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader />
    <main class="home">
      <section class="hero">
        <div class="hero__copy">
          <div class="chill-wordmark" aria-label="CHILL">CHILL</div>
          <p class="eyebrow">A cool-down ritual for skin</p>
          <h1>Meet the balm people call <em>the ice balm.</em></h1>
          <p class="hero__deck">Herbal Ice is a crisp, cooling topical balm with menthol, camphor, and CBD isolate. One 4 oz jar, made for a simple topical routine.</p>
          <a class="button" href="/products/herbal-ice">Explore Herbal Ice <span aria-hidden="true">→</span></a>
          <p class="draft-note">Launch price and batch COA are coming soon.</p>
        </div>
        <a class="hero__image" href="/products/herbal-ice" aria-label="View Herbal Ice Cooling Balm">
          <img src="/images/herbal-ice-hero.webp" alt="Herbal Ice 4 oz cooling balm jar" width="800" height="800" />
        </a>
      </section>
      <section class="fact-rail" aria-label="Herbal Ice details">
        <div><strong>4 oz</strong><span>launch size</span></div>
        <div><strong>Menthol + camphor</strong><span>cooling formula</span></div>
        <div><strong>Topical only</strong><span>external use</span></div>
      </section>
      <section class="home-intro">
        <p class="eyebrow">The cold side of comfort</p>
        <h2>Clean, bright, unmistakably cool.</h2>
        <p>A minimal formula story and an icy finish. Herbal Ice is made with CBD isolate and a focused blend of plant oils, waxes, menthol, camphor, and essential oils.</p>
        <a class="text-link" href="/about">Read the Smoky Chill story →</a>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>
