---
interface Props {
  size?: "header" | "hero";
}
const { size = "hero" } = Astro.props;
---
<svg class={`chill-mark chill-mark--${size}`} viewBox="0 0 500 125" role="img" aria-labelledby={`chill-title-${size}`}>
  <title id={`chill-title-${size}`}>CHILL</title>
  <defs>
    <linearGradient id={`chill-ice-${size}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset=".32" stop-color="#e8fbff" />
      <stop offset=".72" stop-color="#b7eaf5" />
      <stop offset="1" stop-color="#76bfd7" />
    </linearGradient>
  </defs>
  <text x="10" y="88" fill={`url(#chill-ice-${size})`} stroke="#2c7898" stroke-width={size === "header" ? 9 : 6} paint-order="stroke" stroke-linejoin="round" font-family="Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif" font-size="86" font-weight="900" letter-spacing="4">CHILL</text>
  {size === "hero" && <path d="M42 84v13c0 8 3 12 8 12 6 0 9-7 9-25v-1zm78 0v16c0 9 3 14 8 14 6 0 9-8 9-30zm167 0v12c0 8 3 12 8 12 6 0 9-7 9-24z" fill="#79c5dc" stroke="#2c7898" stroke-width="2" stroke-linejoin="round" />}
  <path d="M30 35l18-7m63 1 17-6m128 6 19-7m70 10 14-5" stroke="#fff" stroke-width="4" stroke-linecap="round" opacity=".95" />
</svg>
