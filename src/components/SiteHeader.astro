---
import { getMenu } from "emdash";
import { GuestCartNav } from "../features/guest-cart/ui.ts";

const menu = await getMenu("primary");
---
<div class="site-notice" role="status">Draft storefront · checkout unavailable until a server-owned Payments binding exists.</div>
<header class="site-header">
  <a class="site-brand" href="/" aria-label="Smoky Chill home"><span>smoky</span>chill<span class="site-brand__ice">°</span></a>
  <nav class="site-nav" aria-label="Primary navigation">
    {(menu?.items ?? [
      { label: "Herbal Ice", url: "/products/herbal-ice" },
      { label: "Our story", url: "/about" },
      { label: "FAQ", url: "/faq" },
      { label: "Contact", url: "/contact" },
    ]).map((item) => <a href={item.url}>{item.label}</a>)}
    <GuestCartNav />
  </nav>
</header>
